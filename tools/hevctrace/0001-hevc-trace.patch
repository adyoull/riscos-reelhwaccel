From cf2066e48771042e7c2b8e89cef12212e13e4306 Mon Sep 17 00:00:00 2001
From: Andrew Youll <andrewyoull86@gmail.com>
Date: Fri, 2 Oct 2026 19:10:01 +0100
Subject: [PATCH] avcodec/hevc: trace for hardware decoder tests
 (riscos-reelhwaccel's hevctrace)

With HEVC_TRACE set, the HEVC decoder writes each picture's V4L2 stateless
HEVC controls, its slices and Adler-32s of the decoded picture to that
file. Decode with one thread.
---
 libavcodec/Makefile     |   2 +-
 libavcodec/hevc_ctrls.h | 513 ++++++++++++++++++++++++++++++++++++++++
 libavcodec/hevc_trace.c | 498 ++++++++++++++++++++++++++++++++++++++
 libavcodec/hevc_trace.h |   9 +
 libavcodec/hevcdec.c    |   3 +
 5 files changed, 1024 insertions(+), 1 deletion(-)
 create mode 100644 libavcodec/hevc_ctrls.h
 create mode 100644 libavcodec/hevc_trace.c
 create mode 100644 libavcodec/hevc_trace.h

diff --git a/libavcodec/Makefile b/libavcodec/Makefile
index 457ec58..3773185 100644
--- a/libavcodec/Makefile
+++ b/libavcodec/Makefile
@@ -403,7 +403,7 @@ OBJS-$(CONFIG_HAP_DECODER)             += hapdec.o hap.o
 OBJS-$(CONFIG_HAP_ENCODER)             += hapenc.o hap.o
 OBJS-$(CONFIG_HCA_DECODER)             += hcadec.o
 OBJS-$(CONFIG_HCOM_DECODER)            += hcom.o
-OBJS-$(CONFIG_HEVC_DECODER)            += hevcdec.o hevc_mvs.o \
+OBJS-$(CONFIG_HEVC_DECODER)            += hevcdec.o hevc_trace.o hevc_mvs.o \
                                           hevc_cabac.o hevc_refs.o hevcpred.o    \
                                           hevcdsp.o hevc_filter.o hevc_data.o \
                                           h274.o
diff --git a/libavcodec/hevc_ctrls.h b/libavcodec/hevc_ctrls.h
new file mode 100644
index 0000000..ef5f709
--- /dev/null
+++ b/libavcodec/hevc_ctrls.h
@@ -0,0 +1,513 @@
